# 容器内服务端口
PORT=3000

# 宿主机回环映射端口（仅供本机调试；对外入口由 web-gateway 反代容器网络内的 mym-app）
APP_PORT=8080

# SQLite 数据库文件路径（生产容器内为 /data/app.db，配合 compose 卷持久化）
DB_PATH=/data/app.db

# 上传文件存储目录（相对项目根目录；容器内即 /app/uploads，配合 compose 卷持久化）
UPLOAD_DIR=uploads

# ===== 鉴权（生产必填）=====
# JWT 签名密钥
JWT_SECRET=please-change-me-to-a-long-random-string
# bcrypt 加密轮数
BCRYPT_SALT_ROUNDS=14

# 首次启动时自动创建的管理员账号（已存在同名用户则跳过）
ADMIN_DEFAULT_EMAIL=admin@example.com
ADMIN_DEFAULT_PASSWORD=please-change-me

# ===== 第三方服务密钥（生产必填）=====
# 火山引擎方舟（豆包大模型）API Key，用于单词/句子释义
ARK_API_KEY=
# 豆包模型 ID 或推理接入点（ep-xxxx）；留空则用代码内默认值
ARK_MODEL=
# 火山引擎语音合成 TTS 的 AppID 与 Token
TTS_APP_ID=
TTS_TOKEN=
# v3 单向流式接口所需的资源 ID 与固定 app key
TTS_RESOURCE_ID=seed-tts-2.0
TTS_APP_KEY=aGjiRDfUWi
# 音色 ID（豆包语音合成 2.0 音色）
TTS_SPEAKER=zh_female_vv_uranus_bigtts
# 语音缓存容量上限（MB），超出后按最久未使用淘汰
TTS_CACHE_MAX_MB=500
# 验证码 AES 加密密钥（需 32 字节）
CAPTCHA_SECRET_KEY=please-change-me-32-bytes-secret